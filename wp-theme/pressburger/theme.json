{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "color": {
      "custom": false,
      "customGradient": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "papier",     "color": "#F6F4EF", "name": "Papier" },
        { "slug": "papier-warm","color": "#EFECE4", "name": "Papier warm" },
        { "slug": "weiss",      "color": "#FFFFFF", "name": "Weiss" },
        { "slug": "navy",       "color": "#22345A", "name": "Navy" },
        { "slug": "navy-dunkel","color": "#16233D", "name": "Navy dunkel" },
        { "slug": "tinte",      "color": "#1B2A47", "name": "Tinte" },
        { "slug": "tinte-weich","color": "#4B5769", "name": "Tinte weich" },
        { "slug": "gold",       "color": "#A07E38", "name": "Gold" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "fontStyle": false,
      "fontWeight": false,
      "letterSpacing": false,
      "textDecoration": false,
      "textTransform": false,
      "dropCap": false,
      "fontFamilies": [
        {
          "slug": "serif",
          "name": "Serif (Ueberschriften)",
          "fontFamily": "\"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, \"Times New Roman\", serif"
        },
        {
          "slug": "sans",
          "name": "Sans (Fliesstext)",
          "fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "klein",  "size": "0.9375rem", "name": "Klein" },
        { "slug": "normal", "size": "1.0625rem", "name": "Normal" },
        { "slug": "lead",   "size": "clamp(1.0625rem, 1.6vw, 1.25rem)", "name": "Einleitung" }
      ]
    },
    "spacing": {
      "customSpacingSize": false,
      "units": [],
      "spacingSizes": []
    },
    "layout": {
      "contentSize": "1140px",
      "wideSize": "1140px"
    },
    "blocks": {
      "core/paragraph": { "color": { "text": false, "background": false } },
      "core/heading":   { "color": { "text": false, "background": false } },
      "core/group":     { "color": { "text": false, "background": false } }
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--papier)", "text": "var(--wp--preset--color--tinte-weich)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--sans)", "fontSize": "var(--wp--preset--font-size--normal)", "lineHeight": "1.7" },
    "elements": {
      "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontWeight": "700", "lineHeight": "1.15" }, "color": { "text": "var(--wp--preset--color--tinte)" } },
      "link": { "color": { "text": "var(--wp--preset--color--navy-dunkel)" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Kopfzeile", "area": "header" },
    { "name": "footer", "title": "Fusszeile", "area": "footer" }
  ],
  "customTemplates": []
}
